# Copy this file to .env and fill in your own values.
# Never upload your real .env file to GitHub.

# Password for the PostgreSQL database (choose something long)
POSTGRES_PASSWORD=change-me-to-a-long-password

# Secret used to sign login tokens. Make it long and random.
# Tip: run  openssl rand -hex 32  in a terminal to create one.
JWT_SECRET=change-me-to-a-random-64-character-string
